# =============================================================
# .gitignore — Files and folders Git should NEVER track
# =============================================================

# Environment variables (contains real passwords — keep secret!)
.env

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Node.js dependencies (re-installed via npm install)
node_modules/

# React production build output
frontend/build/
frontend/dist/

# Docker volumes (local data folder if any)
mysql_data/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# pytest cache
.pytest_cache/
.coverage
htmlcov/
